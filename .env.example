# ---------------------------------------------------------------------------
# Energicotel (ECTL) — environment configuration
#
# Copy to .env (git-ignored) and adjust. In development every value is
# optional: settings fall back to SQLite and a dev SECRET_KEY.
# Production (config.settings.prod) REQUIRES: SECRET_KEY, ALLOWED_HOSTS,
# DATABASE_URL — see config/settings/prod.py.
# ---------------------------------------------------------------------------

# Generate a strong key:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# Comma-separated hosts this site is served from.
ALLOWED_HOSTS=localhost,127.0.0.1

# Database URL. Leave empty in development to use SQLite (var/db.sqlite3).
# Production example (PostgreSQL):
#   DATABASE_URL=postgres://ectl_user:password@localhost:5432/energicotel
DATABASE_URL=

# Full origins allowed for CSRF in production, comma-separated,
# e.g. https://www.energicotel.com
CSRF_TRUSTED_ORIGINS=
